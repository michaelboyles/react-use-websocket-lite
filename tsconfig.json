{
  "compilerOptions": {
    "outDir": "dist",
    "sourceMap": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "target": "ES2017",
    "skipLibCheck": true,
    "lib": ["es2017", "dom"],
    "strict": true,
    "declaration": true,
    "baseUrl": ".",
  },
  "files": [
    "./src/index.ts"
  ],
  "include": [
    "src/*"
  ]
}